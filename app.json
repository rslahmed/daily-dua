{
  "expo": {
    "name": "Daily Dua",
    "slug": "daily-dua",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0A0F0D",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.dailydua.app"
    },
    "android": {
      "package": "com.dailydua.app",
      "adaptiveIcon": {
        "backgroundColor": "#044E39",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/AlMajeed.ttf",
            "./assets/fonts/hafs.ttf",
            "./assets/fonts/HindSiliguri-Regular.ttf",
            "./assets/fonts/HindSiliguri-Medium.ttf",
            "./assets/fonts/HindSiliguri-SemiBold.ttf",
            "./assets/fonts/HindSiliguri-Bold.ttf"
          ]
        }
      ],
      "expo-splash-screen"
    ],
    "extra": {
      "eas": {
        "projectId": "68eccf11-8f66-42b8-9e24-1d8746b0bd4d"
      }
    }
  }
}
